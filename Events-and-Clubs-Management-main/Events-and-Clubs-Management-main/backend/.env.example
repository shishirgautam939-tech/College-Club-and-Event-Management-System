# ── Khalti e-Payment (https://docs.khalti.com/khalti-epayment/) ──
# Defaults in settings.py already point at Khalti's SANDBOX with a public test
# secret key, so the integration works locally without setting anything here.
# Override for production with your LIVE secret key and https://khalti.com/api/v2.
# KHALTI_BASE_URL=https://dev.khalti.com/api/v2
# KHALTI_SECRET_KEY=test_secret_key_68791341fdd94846a146f0457ff7b455
# FRONTEND_URL is used to build the payment return URL (FRONTEND_URL/payment/callback).
FRONTEND_URL=http://localhost:5173
# KHALTI_RETURN_URL=http://localhost:5173/payment/callback
# KHALTI_WEBSITE_URL=http://localhost:5173
