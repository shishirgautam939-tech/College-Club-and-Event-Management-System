# Points the app at your Django backend. Leave unset during local dev and
# src/api/config.js picks a sensible default per platform (Android emulator:
# 10.0.2.2, iOS simulator: 127.0.0.1). A *physical* phone can't reach either
# of those — set this to your dev machine's LAN IP instead, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.23:8000/api/
EXPO_PUBLIC_API_URL=
